# Provider portal deployment. Copy to .env.portal on the server and fill in.
# .env.portal is gitignored — it holds real secrets.

# ── Required ──────────────────────────────────────────

# Many provider organizations on one deployment, each with its own /p/<slug>.
DIRECTORY_MODE=portal

# The canonical public origin. NOT optional here: behind Traefik the request the
# app sees is plain http on an internal name, and the address this deployment
# hands a provider ends up compiled into their shipped mobile builds. Get it
# wrong and every provider ships a URL that does not resolve.
REGISTRY_PUBLIC_URL=https://providers.openedx-lms.stepanok.com

# A long random string. Without it, sign-in tokens use a throwaway key that
# resets on every restart, signing everyone out.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The registry operator's account, created on the FIRST boot of an empty
# database. Nothing creates it later — set both before you start the container.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Registry Operator

# ── Optional ──────────────────────────────────────────

# Shown as the operator's brand on the sign-in screen and the operator console.
# Providers see their own organization name instead, everywhere it matters.
PROVIDER_NAME=Open X Provider Portal
PROVIDER_TAGLINE=Your platforms, in your own app

# Point at PostgreSQL for many concurrent writers. The default is SQLite in the
# container's /app/data, which docker-compose.portal.yml maps to ./data-portal.
# DATABASE_URL=postgresql://user:pass@host/dbname

# Complaint reporting is closed in portal mode, so WEBHOOK_URL never fires here.
# SMTP is only used if the operator emails a provider from the console.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Leave SEED_DEMO unset in production. With SEED_DEMO=1 an empty database gets
# two demo providers with published platforms and known passwords.
# SEED_DEMO=1
